{
  "name": "video-saas-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "concurrently -n api,worker,frontend -c blue,green,magenta \"corepack pnpm --filter @video/api dev\" \"corepack pnpm --filter @video/worker dev\" \"corepack pnpm --filter @video/frontend dev\"",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "corepack pnpm prisma:generate:test && vitest run tests/integration",
    "typecheck": "corepack pnpm -r typecheck",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "prisma generate --schema prisma/schema.test.prisma",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.0.1",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
