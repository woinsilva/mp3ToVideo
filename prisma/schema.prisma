generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  owner
  admin
  member
}

enum ProjectStatus {
  draft
  uploaded
  queued
  processing
  analyzing
  storyboarding
  generating_scenes
  awaiting_references
  rendering
  completed
  failed
}

enum ProjectGenerationMode {
  music
  prompt
  image
}

enum FrameInterpolationMode {
  off
  rife_2x
}

enum LyricsSource {
  manual
  whisper
  mock
}

enum MusicSectionType {
  intro
  verse
  chorus
  bridge
  outro
  instrumental
}

enum SceneStatus {
  pending
  generating
  completed
  failed
}

enum AssetType {
  audio
  image
  source_image
  storyboard_image
  video_scene
  render
  interpolated_render
  subtitle
  temp
}

enum RenderStatus {
  pending
  rendering
  completed
  failed
}

enum ProcessingJobStatus {
  queued
  active
  completed
  failed
  retrying
}

enum SceneRenderAttemptStatus {
  queued
  submitted
  waiting_external
  confirmed_external_active
  completed
  failed
  cancelled
  abandoned
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  createdProjects     Project[]            @relation("ProjectCreatedBy")
  organizationMembers OrganizationMember[]
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?
  members   OrganizationMember[]
  projects  Project[]
  assets    Asset[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id                   String                @id @default(cuid())
  organizationId       String
  createdByUserId      String
  title                String
  generationMode       ProjectGenerationMode @default(music)
  generationPrompt     String?
  stabilityTest        Boolean               @default(false)
  wanOnly              Boolean               @default(false)
  generationSeed       Int?
  generationCfg        Float?
  generationSteps      Int?
  generationFps        Int                   @default(16)
  frameInterpolationMode FrameInterpolationMode @default(off)
  sourceImageAssetId   String?               @unique
  clipDurationSeconds  Float?
  sceneDurationSeconds Float?
  visualCheckpointName String?
  status               ProjectStatus         @default(draft)
  errorMessage         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser        User                  @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  track                Track?
  lyrics               Lyrics?
  musicSections        MusicSection[]
  storyboard           Storyboard?
  scenes               Scene[]
  renders              Render[]
  assets               Asset[]
  processingJobs       ProcessingJob[]
  sceneRenderAttempts  SceneRenderAttempt[]
  sourceImageAsset     Asset?                @relation("ProjectSourceImageAsset", fields: [sourceImageAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Track {
  id               String   @id @default(cuid())
  projectId        String   @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  durationSeconds  Float?
  storagePath      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lyrics {
  id             String       @id @default(cuid())
  projectId      String       @unique
  source         LyricsSource
  rawText        String
  normalizedText String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MusicSection {
  id            String           @id @default(cuid())
  projectId     String
  type          MusicSectionType
  title         String
  startSeconds  Float
  endSeconds    Float
  lyricsExcerpt String?
  energy        Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes        Scene[]

  @@index([projectId, startSeconds])
}

model Storyboard {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  visualAssetId       String?
  concept             String
  visualStyle         String
  mood                String
  colorPalette        String
  narrativeSummary    String
  visualPrompt        String?
  revisionInstruction String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visualAsset         Asset?   @relation("StoryboardVisualAsset", fields: [visualAssetId], references: [id], onDelete: SetNull)
}

model Scene {
  id                    String               @id @default(cuid())
  projectId             String
  musicSectionId        String?
  index                 Int
  title                 String
  description           String
  startSeconds          Float
  endSeconds            Float
  durationSeconds       Float
  status                SceneStatus          @default(pending)
  visualProvider        String?
  videoAssetId          String?
  referenceImageAssetId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  musicSection          MusicSection?        @relation(fields: [musicSectionId], references: [id], onDelete: SetNull)
  videoAsset            Asset?               @relation("SceneVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  referenceImageAsset   Asset?               @relation("SceneReferenceImageAsset", fields: [referenceImageAssetId], references: [id], onDelete: SetNull)
  prompt                ScenePrompt?
  renderAttempts        SceneRenderAttempt[]

  @@unique([projectId, index])
  @@index([projectId, startSeconds])
}

model SceneRenderAttempt {
  id                       String                   @id @default(cuid())
  projectId                String
  sceneId                  String
  attemptNumber            Int
  provider                 String
  workflowName             String?
  status                   SceneRenderAttemptStatus @default(queued)
  promptId                 String?
  positivePrompt           String?
  negativePrompt           String?
  seed                     Int?
  sourceType               String
  hasReferenceImage        Boolean                  @default(false)
  width                    Int?
  height                   Int?
  fps                      Int?
  durationSeconds          Float?
  requestedDurationSeconds Float?
  effectiveDurationSeconds Float?
  expectedFrameCount       Int?
  steps                    Int?
  cfg                      Float?
  sampler                  String?
  scheduler                String?
  checkpointName           String?
  unetName                 String?
  clipName                 String?
  clipType                 String?
  vaeName                  String?
  modelShift               Float?
  startedAt                DateTime                 @default(now())
  submittedAt              DateTime?
  firstExternalSeenAt      DateTime?
  lastHeartbeatAt          DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  errorMessage             String?
  metadata                 Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  project                  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene                    Scene                    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, attemptNumber])
  @@index([projectId, status])
  @@index([sceneId, status])
  @@index([promptId])
}

model ScenePrompt {
  id             String   @id @default(cuid())
  sceneId        String   @unique
  provider       String
  positivePrompt String
  negativePrompt String
  style          String
  camera         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  scene          Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
}

model Asset {
  id                     String       @id @default(cuid())
  organizationId         String
  projectId              String
  type                   AssetType
  mimeType               String
  storagePath            String
  sizeBytes              Int
  width                  Int?
  height                 Int?
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  render                 Render?
  storyboardVisualFor    Storyboard[] @relation("StoryboardVisualAsset")
  sceneVideoFor          Scene[]      @relation("SceneVideoAsset")
  sceneReferenceImageFor Scene[]      @relation("SceneReferenceImageAsset")
  sourceImageFor         Project?     @relation("ProjectSourceImageAsset")

  @@index([organizationId, projectId, type])
}

model Render {
  id              String       @id @default(cuid())
  projectId       String
  status          RenderStatus @default(pending)
  assetId         String?      @unique
  durationSeconds Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset           Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model ProcessingJob {
  id            String              @id @default(cuid())
  projectId     String
  queueName     String
  jobName       String
  bullJobId     String?
  status        ProcessingJobStatus
  progress      Int                 @default(0)
  detailMessage String?
  activityLog   Json?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, queueName])
}
