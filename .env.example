NODE_ENV=development

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_saas
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

API_PORT=3000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

ENABLE_WHISPER=false
WHISPER_PYTHON_PATH=python
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_TIMEOUT_MS=600000
WHISPER_LANGUAGE=

ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
SCENE_VISUAL_PROVIDER=procedural
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT_MS=300000
COMFYUI_POLL_INTERVAL_MS=3000
COMFYUI_CHECKPOINT_NAME=sd_xl_turbo_1.0.safetensors
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=576
COMFYUI_STEPS=8
COMFYUI_CFG=1.8
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal
COMFYUI_PORT=8188
COMFYUI_GIT_REF=master
COMFYUI_PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
COMFYUI_APT_EXTRA_PACKAGES=
COMFYUI_PIP_EXTRA_PACKAGES=
COMFYUI_CLI_ARGS=--listen 0.0.0.0
COMFYUI_MODELS_HOST_PATH=./storage/comfyui/models
COMFYUI_INPUT_HOST_PATH=./storage/comfyui/input
COMFYUI_OUTPUT_HOST_PATH=./storage/comfyui/output
COMFYUI_CUSTOM_NODES_HOST_PATH=./storage/comfyui/custom_nodes
COMFYUI_USER_HOST_PATH=./storage/comfyui/user
COMFYUI_TEMP_HOST_PATH=./storage/comfyui/temp

ENABLE_AI_FALLBACKS=true
