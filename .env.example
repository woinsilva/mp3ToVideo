NODE_ENV=development

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_saas
REDIS_HOST=localhost
REDIS_PORT=6379
WORKER_LOCK_DURATION_MS=1800000
WORKER_STALLED_INTERVAL_MS=30000

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

API_PORT=3000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

ENABLE_WHISPER=true
WHISPER_PYTHON_PATH=python
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_FALLBACK_DEVICE=cpu
WHISPER_FALLBACK_COMPUTE_TYPE=int8
WHISPER_TIMEOUT_MS=600000
WHISPER_LANGUAGE=
WHISPER_EXTRA_PATHS=

ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
SCENE_VISUAL_PROVIDER=procedural
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_OUTPUT_HOST_PATH=./storage/comfyui/output
COMFYUI_TIMEOUT_MS=86400000
COMFYUI_POLL_INTERVAL_MS=3000
COMFYUI_ENABLE_IMAGE_FALLBACK=false
COMFYUI_CHECKPOINT_NAME=
COMFYUI_VIDEO_UNET_NAME=wan2.2_ti2v_5B_fp16.safetensors
COMFYUI_VIDEO_WORKFLOW_NAME=wan-2.2-ti2v-5b
COMFYUI_VIDEO_CLIP_NAME=umt5_xxl_fp8_e4m3fn_scaled.safetensors
COMFYUI_VIDEO_CLIP_TYPE=wan
COMFYUI_VIDEO_VAE_NAME=wan2.2_vae.safetensors
COMFYUI_VIDEO_MODEL_SHIFT=8
COMFYUI_VIDEO_FPS=16
COMFYUI_WIDTH=1280
COMFYUI_HEIGHT=704
COMFYUI_STEPS=24
COMFYUI_CFG=4.5
COMFYUI_SAMPLER=uni_pc
COMFYUI_SCHEDULER=simple

ENABLE_AI_FALLBACKS=false
